{# Copier renders this into each project's .github/dependabot.yml. The root
copy is its render with every language: edit this file, then run
`mise run template:sync`. -#}
# Opens PRs that update pinned dependencies, including the commit each action
# is pinned to. Each language task adds an entry for its package ecosystem.
version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    # Waits a week after a release before proposing it, so a compromised
    # release is more likely to be caught first. Security updates don't wait.
    cooldown:
      default-days: 7
  # The docs build's tools in docs/{% if python %}, and the Python package's tools{% endif %}.
  - package-ecosystem: uv
    directories: [{% if python %}/, {% endif %}/docs]
    schedule:
      interval: weekly
    cooldown:
      default-days: 7
{% if rust %}
  - package-ecosystem: cargo
    directory: /
    schedule:
      interval: weekly
    cooldown:
      default-days: 7
  - package-ecosystem: rust-toolchain
    directory: /
    schedule:
      interval: weekly
    cooldown:
      default-days: 7
{% endif %}
{% if typescript %}
  # Dependabot's npm ecosystem also updates pnpm-lock.yaml.
  - package-ecosystem: npm
    directory: /
    schedule:
      interval: weekly
    cooldown:
      default-days: 7
{% endif %}
