{# Copier renders this into each project's .github/CODEOWNERS. The root copy
is its render with the root's answers and template_repository: edit this
file, then run `mise run template:sync`. -#}
# Paths that need the owner's review, which the owned-paths check enforces in
# auto mode: those where an agent's mistake or manipulation could weaken the
# merge gates themselves and no check would notice. CI and Bugbot cover every
# other path (docs/auto-mode.md#what-still-needs-the-owner).
/.cursor/                                   @{{ github_owner }}
/.github/CODEOWNERS                         @{{ github_owner }}
/.github/rulesets/                          @{{ github_owner }}
/.github/workflows/                         @{{ github_owner }}
/.github/scripts/auto_merge.sh              @{{ github_owner }}
/.github/scripts/auto_merge_test.sh         @{{ github_owner }}
/.github/scripts/approve_agent_prs.sh       @{{ github_owner }}
/.github/scripts/approve_agent_prs_test.sh  @{{ github_owner }}
/.github/scripts/owned_paths.sh             @{{ github_owner }}
/.github/scripts/owned_paths_test.sh        @{{ github_owner }}
/.github/scripts/needs_human_review.sh      @{{ github_owner }}
/.github/scripts/needs_human_review_test.sh @{{ github_owner }}
/.github/scripts/ci_changes.sh              @{{ github_owner }}
/.github/scripts/ci_changes_test.sh         @{{ github_owner }}
/deny.toml                                  @{{ github_owner }}
{% if template_repository %}
# Files only the template has, which copier.yml leaves out of projects.
/.github/CODEOWNERS.jinja                   @{{ github_owner }}
{% endif %}
