# Doxygen settings for the C and C++ API reference. docs/build.sh runs
# Doxygen from the repository root, and Breathe reads the XML it writes into
# the Sphinx site. Settings not listed keep Doxygen's defaults.

# The public headers are the API.
INPUT                = cpp/include
RECURSIVE            = YES
OUTPUT_DIRECTORY     = docs/_generated
GENERATE_HTML        = NO
GENERATE_LATEX       = NO
GENERATE_XML         = YES
XML_OUTPUT           = doxygen
QUIET                = YES

# Fail on an undocumented public symbol or parameter, or a malformed doc
# comment, after reporting every warning. Undocumented symbols are reported
# only while EXTRACT_ALL is NO, its default.
EXTRACT_ALL          = NO
WARN_IF_UNDOCUMENTED = YES
WARN_NO_PARAMDOC     = YES
WARN_AS_ERROR        = FAIL_ON_WARNINGS
