# Every environment variable the project reads, by name, with no values.
# Locally, copy to .env and fill in. For cloud agents, set them as secrets in
# the Cursor dashboard. Add a line here in the PR that first reads a variable.

# A Cursor team Admin API key, for `mise run spend`.
CURSOR_ADMIN_API_KEY=

# The shared compute server's https:// URL and the agents' service-account
# token, which `mise run job:launch`, `job:observe`, and `job:cancel` need
# (docs/compute-jobs.md). The owner gives them out; never start a server.
SKYPILOT_API_SERVER_ENDPOINT=
SKYPILOT_SERVICE_ACCOUNT_TOKEN=

# Optional: the read-only key of the IAM user compute-jobs-observer, and the
# job archive's bucket and region, with which `mise run job:observe` reads a
# job's progress and outputs from S3, also while the server is down.
COMPUTE_JOBS_AWS_ACCESS_KEY_ID=
COMPUTE_JOBS_AWS_SECRET_ACCESS_KEY=
COMPUTE_JOBS_BUCKET=
COMPUTE_JOBS_AWS_REGION=

# A Cursor user or service account API key, which `mise run spend` uses to read
# each cloud agent's name, repository, and branch. Optional: without it the
# report has no labels.
CURSOR_API_KEY=
